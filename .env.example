# Configuration de l'application IoT Alert System
# Copier ce fichier vers .env et remplir les valeurs

# === Base de données ===
# SQLite (défaut)
DATABASE_URL=sqlite:///./alerts.db

# PostgreSQL (optionnel — pour la production)
# DATABASE_URL=postgresql://iot:iotpassword@localhost:5432/iotdb
# Nécessite : pip install psycopg2-binary

# === Redis (cache optionnel) ===
# Redis est utilisé pour le cache des KPIs, heatmap et corrélation
# Si absent, utilise un cache dict en mémoire (fallback automatique)
REDIS_URL=redis://localhost:6379

# === OAuth2 Google (optionnel) ===
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:8084/auth/google/callback

# === Application ===
PYTHONUNBUFFERED=1
# PORT=8084  # Port fixe (ne pas modifier)

# === Telegram (optionnel) ===
# Configurer via /config dans l'interface ou directement dans telegram_config.json
# TELEGRAM_BOT_TOKEN=your-bot-token
# TELEGRAM_CHAT_ID=your-chat-id

# === SMTP Email (optionnel) ===
# Configurer via /config dans l'interface ou directement dans email_config.json
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
